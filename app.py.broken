@app.route('/medecin')
@login_required
def medecin():
    if current_user.role != 'medecin':
        return redirect(url_for('home'))
    patients = get_patients_for_medecin(current_user.id)
    archived_patients = get_archived_patients_for_medecin(current_user.id)
    return render_template('medecin.html', user=current_user, 
                          patients=patients, 
                          archived_patients=archived_patients)
@app.route('/medecin/add-patient', methods=['GET','POST'])
@login_required
def add_patient():
    if current_user.role != 'medecin':
        return redirect(url_for('home'))
    if request.method == 'POST':
        action = request.form.get('action')

        if action == 'create':
            nom    = request.form.get('nom','').strip()
            prenom = request.form.get('prenom','').strip()
            code   = request.form.get('code','').strip().upper()
            if not all([nom, prenom, code]):
                flash("Tous les champs sont obligatoires.", "error")
                return render_template('add_patient.html', user=current_user)
            ok, msg = create_patient_for_medecin(nom, prenom, code, current_user.id)
            if ok:
                flash(f"✅ {msg}. Code à communiquer au patient : {code}", "success")
                return redirect(url_for('medecin'))
            flash(msg, "error")

        elif action == 'link':
            code = request.form.get('existing_code','').strip().upper()
            if not code:
                flash("Entrez le code du patient.", "error")
                return render_template('add_patient.html', user=current_user)
            ok, msg = add_patient_to_medecin(current_user.id, code)
            if ok:
                patient = get_patient_by_code(code)
                flash(f"✅ Patient {patient['prenom']} {patient['nom']} ajouté.", "success")
                return redirect(url_for('medecin'))
            flash(msg, "error")

    return render_template('add_patient.html', user=current_user)

@app.route('/medecin/remove-patient/<code>', methods=['POST'])
@login_required
def remove_patient(code):
    if current_user.role != 'medecin':
        return redirect(url_for('home'))
    patient = get_patient_by_code(code)
    ok, msg = remove_patient_from_medecin(current_user.id, code)
    if ok and patient:
        flash(f"✅ {patient['prenom']} {patient['nom']} retiré.", "success")
    else:
        flash(msg, "error")
    return redirect(url_for('medecin'))
@app.route('/medecin/archive-patient/<code>', methods=['POST'])
@login_required
def archive_patient_route(code):
    if current_user.role != 'medecin':
        return redirect(url_for('home'))
    
    patient = get_patient_by_code(code)
    if not patient:
        flash("Patient introuvable.", "error")
        return redirect(url_for('medecin'))
    
    patients_ids = [p['code'] for p in get_patients_for_medecin(current_user.id)]
    if code not in patients_ids:
        flash("Ce patient n'est pas dans votre liste.", "error")
        return redirect(url_for('medecin'))
    
    ok, msg = archive_patient(code)
    if ok:
        flash(f"✅ Patient {patient['prenom']} {patient['nom']} archivé.", "success")
        log.info(f"📦 Patient {code} archivé par {current_user.email}")
    else:
        flash(f"❌ {msg}", "error")
    
    return redirect(url_for('medecin'))

@app.route('/medecin/unarchive-patient/<code>', methods=['POST'])
@login_required
def unarchive_patient_route(code):
    if current_user.role != 'medecin':
        return redirect(url_for('home'))
    
    patient = get_patient_by_code(code)
    if not patient:
        flash("Patient introuvable.", "error")
        return redirect(url_for('medecin'))
    
    ok, msg = unarchive_patient(code)
    if ok:
        flash(f"✅ Patient {patient['prenom']} {patient['nom']} restauré.", "success")
        log.info(f"📦 Patient {code} restauré par {current_user.email}")
    else:
        flash(f"❌ {msg}", "error")
    
    return redirect(url_for('medecin'))
    
    # Vérifier accès
    patients_ids = [p['code'] for p in get_patients_for_medecin(current_user.id)]
    if code not in patients_ids:
        flash("Ce patient n'est pas dans votre liste.", "error")
        return redirect(url_for('medecin'))
    
    # Archiver
    ok, msg = archive_patient(code)
    if ok:
        flash(f"✅ Patient {patient['prenom']} {patient['nom']} archivé.", "success")
        log.info(f"📦 Patient {code} archivé par {current_user.email}")
    else:
        flash(f"❌ {msg}", "error")
    
    return redirect(url_for('medecin'))
    
    # Désarchiver
    ok, msg = unarchive_patient(code)
    if ok:
        flash(f"✅ Patient {patient['prenom']} {patient['nom']} restauré.", "success")
        log.info(f"📦 Patient {code} restauré par {current_user.email}")
    else:
        flash(f"❌ {msg}", "error")
    
    return redirect(url_for('medecin'))
# ═══════════════════════════════════════════════
# DASHBOARD
# ═══════════════════════════════════════════════

@app.route('/dashboard/<code>')
@login_required
def dashboard(code):
    print(f"DEBUG: user_id={current_user.id}, role={current_user.role}, patient_code={current_user.patient_code}, code={code}")
    patient = get_patient_by_code(code)
    if not patient:
        flash("Patient introuvable.", "error")
        return redirect(url_for('home'))

    if current_user.role == 'medecin':
        patients_ids = [p['code'] for p in get_patients_for_medecin(current_user.id)]
        if code not in patients_ids:
            flash("Ce patient n'est pas dans votre liste.", "error")
            return redirect(url_for('medecin'))
    elif current_user.patient_code != code:
        flash("Accès non autorisé.", "error")
        return redirect(url_for('home'))

    alerts = get_alerts(code, limit=20)
    return render_template('dashboard.html',
                           user=current_user,
                           patient=patient,
                           alerts=alerts,
                           patient_code=patient['code'])

