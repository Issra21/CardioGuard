import sqlite3, hashlib
DB_PATH = "/home/azureuser/app/ecg.db"

def get_conn():
    conn = sqlite3.connect(DB_PATH, timeout=10)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")  # évite les locks
    return conn

def init_db():
    conn = get_conn()
    c = conn.cursor()

    c.execute('''CREATE TABLE IF NOT EXISTS users (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        nom TEXT NOT NULL, prenom TEXT NOT NULL,
        email TEXT UNIQUE NOT NULL,
        password_hash TEXT NOT NULL,
        role TEXT NOT NULL,
        patient_code TEXT,
        verified INTEGER DEFAULT 0,
        verification_token TEXT UNIQUE,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP)''')

    c.execute('''CREATE TABLE IF NOT EXISTS patients (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        nom TEXT NOT NULL, prenom TEXT NOT NULL,
        code TEXT UNIQUE NOT NULL,
        topic_mqtt TEXT NOT NULL DEFAULT "ecg/data",
        archived INTEGER DEFAULT 0,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP)''')
    # Table de liaison médecin ↔ patient (plusieurs médecins peuvent suivre un patient)
    c.execute('''CREATE TABLE IF NOT EXISTS medecin_patients (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        medecin_id INTEGER NOT NULL,
        patient_code TEXT NOT NULL,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        UNIQUE(medecin_id, patient_code),
        FOREIGN KEY(medecin_id) REFERENCES users(id))''')

    c.execute('''CREATE TABLE IF NOT EXISTS alerts (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        patient_code TEXT NOT NULL, proba REAL,
        timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP)''')

    conn.commit(); conn.close()
    print("✅ Base de données initialisée")

# ─── HASH ─────────────────────────────────────────
def hash_password(p): return hashlib.sha256(p.encode()).hexdigest()
def check_password(p, h): return hash_password(p) == h

# ─── UTILISATEURS ─────────────────────────────────
def create_user(nom, prenom, email, password, role, patient_code=None):
    try:
        conn = get_conn()
        conn.execute(
            'INSERT INTO users (nom,prenom,email,password_hash,role,patient_code) VALUES (?,?,?,?,?,?)',
            (nom, prenom, email, hash_password(password), role, patient_code))
        conn.commit(); conn.close()
        return True, "OK"
    except sqlite3.IntegrityError:
        return False, "Cet email est déjà utilisé"

def update_password(email, new_password):
    conn = get_conn()
    conn.execute('UPDATE users SET password_hash=? WHERE email=?',
                 (hash_password(new_password), email))
    conn.commit(); conn.close()

def get_user_by_email(email):
    conn = get_conn()
    c = conn.cursor()
    c.execute("SELECT * FROM users WHERE email=?", (email,))
    r = c.fetchone(); conn.close(); return r

def get_user_by_id(uid):
    conn = get_conn()
    c = conn.cursor()
    c.execute("SELECT * FROM users WHERE id=?", (uid,))
    r = c.fetchone(); conn.close(); return r

def get_user_patient_code(email):
    row = get_user_by_email(email)
    return row['patient_code'] if row else None

# ─── PATIENTS ─────────────────────────────────────
def create_patient(nom, prenom, code, topic_mqtt="ecg/data"):
    """Créer un patient dans la table patients"""
    try:
        conn = get_conn()
        conn.execute('INSERT INTO patients (nom,prenom,code,topic_mqtt) VALUES (?,?,?,?)',
                     (nom, prenom, code, topic_mqtt))
        conn.commit(); conn.close()
        return True, "Patient créé"
    except sqlite3.IntegrityError:
        return False, "Ce code patient existe déjà"

def get_patient_by_code(code):
    conn = get_conn()
    c = conn.cursor()
    c.execute("SELECT * FROM patients WHERE code=?", (code,))
    r = c.fetchone(); conn.close(); return r

def get_all_patients():
    """Tous les patients (admin seulement)"""
    conn = get_conn()
    c = conn.cursor()
    c.execute("SELECT * FROM patients ORDER BY nom")
    r = c.fetchall(); conn.close(); return r

# ─── LIAISON MÉDECIN ↔ PATIENT ────────────────────
def add_patient_to_medecin(medecin_id, patient_code):
    """Associer un patient existant à un médecin"""
    # Vérifier que le patient existe
    if not get_patient_by_code(patient_code):
        return False, f"Code patient '{patient_code}' introuvable"
    try:
        conn = get_conn()
        conn.execute(
            'INSERT INTO medecin_patients (medecin_id, patient_code) VALUES (?,?)',
            (medecin_id, patient_code))
        conn.commit(); conn.close()
        return True, "Patient ajouté"
    except sqlite3.IntegrityError:
        return False, "Ce patient est déjà dans votre liste"

def remove_patient_from_medecin(medecin_id, patient_code):
    """Retirer un patient de la liste d'un médecin (sans supprimer le patient)"""
    conn = get_conn()
    conn.execute(
        'DELETE FROM medecin_patients WHERE medecin_id=? AND patient_code=?',
        (medecin_id, patient_code))
    conn.commit(); conn.close()
    return True, "Patient retiré de votre liste"


def get_patients_for_medecin(medecin_id):
    """Patients actifs (non archivés) du médecin"""
    conn = get_conn()
    c = conn.cursor()
    c.execute('''
        SELECT p.* FROM patients p
        INNER JOIN medecin_patients mp ON p.code = mp.patient_code
        WHERE mp.medecin_id = ? AND (p.archived IS NULL OR p.archived = 0)
        ORDER BY p.nom
    ''', (medecin_id,))
    r = c.fetchall()
    conn.close()
    return r
def create_patient_for_medecin(nom, prenom, code, medecin_id, topic_mqtt="ecg/data"):
    """Créer un nouveau patient ET l'associer au médecin"""
    ok, msg = create_patient(nom, prenom, code, topic_mqtt)
    if not ok:
        return False, msg
    ok2, msg2 = add_patient_to_medecin(medecin_id, code)
    if not ok2:
        return False, msg2
    return True, f"Patient {prenom} {nom} créé et ajouté à votre liste"

# ─── ALERTES ──────────────────────────────────────
def save_alert(patient_code, proba):
    conn = get_conn()
    conn.execute('INSERT INTO alerts (patient_code,proba) VALUES (?,?)',
                 (patient_code, proba))
    conn.commit(); conn.close()

def get_alerts(patient_code, limit=20):
    conn = get_conn()
    c = conn.cursor()
    c.execute("SELECT * FROM alerts WHERE patient_code=? ORDER BY timestamp DESC LIMIT ?",
              (patient_code, limit))
    r = c.fetchall(); conn.close(); return r

# ─── DONNÉES PAR DÉFAUT ───────────────────────────
def insert_default_data():
    """Insérer patient Issra par défaut si pas encore créé"""
    conn = get_conn()
    c = conn.cursor()
    c.execute("SELECT id FROM patients WHERE code='ISSRA2026'")
    if not c.fetchone():
        conn.close()
        create_patient("Saidi", "Issra", "ISSRA2026", "ecg/data")
        print("✅ Patient Issra Saidi créé (code: ISSRA2026)")
    else:
        conn.close()
        print("ℹ️  Patient Issra déjà existant")

if __name__ == "__main__":
    init_db()
    insert_default_data()
    print("✅ Base de données prête")
# ─── ARCHIVAGE PATIENT ──────────────────────────
def archive_patient(patient_code):
    try:
        conn = get_conn()
        conn.execute('UPDATE patients SET archived = 1 WHERE code = ?', (patient_code,))
        conn.commit()
        conn.close()
        return True, "Patient archivé"
    except Exception as e:
        return False, f"Erreur: {e}"

def unarchive_patient(patient_code):
    try:
        conn = get_conn()
        conn.execute('UPDATE patients SET archived = 0 WHERE code = ?', (patient_code,))
        conn.commit()
        conn.close()
        return True, "Patient désarchivé"
    except Exception as e:
        return False, f"Erreur: {e}"
def get_patients_for_medecin(medecin_id):
    conn = get_conn()
    c = conn.cursor()
    c.execute('''
        SELECT p.* FROM patients p
        INNER JOIN medecin_patients mp ON p.code = mp.patient_code
        WHERE mp.medecin_id = ? AND (p.archived IS NULL OR p.archived = 0)
        ORDER BY p.nom
    ''', (medecin_id,))
    r = c.fetchall()
    conn.close()
    return r
def get_archived_patients_for_medecin(medecin_id):
    conn = get_conn()
    c = conn.cursor()
    c.execute('''
        SELECT p.* FROM patients p
        INNER JOIN medecin_patients mp ON p.code = mp.patient_code
        WHERE mp.medecin_id = ? AND p.archived = 1
        ORDER BY p.nom
    ''', (medecin_id,))
    r = c.fetchall()
    conn.close()
    return r
def verify_email(token):
    """Vérifier l'email avec un token"""
    try:
        conn = get_conn()
        c = conn.cursor()
        c.execute('SELECT id FROM users WHERE verification_token = ?', (token,))
        user = c.fetchone()
        if user:
            conn.execute('UPDATE users SET verified = 1, verification_token = NULL WHERE verification_token = ?', (token,))
            conn.commit()
            conn.close()
            return True, "Email vérifié ✅"
        conn.close()
        return False, "Token invalide"
    except Exception as e:
        return False, f"Erreur: {e}"
