# ─── MODÈLE USER ────────────────────────────────
class User(UserMixin):
    def __init__(self, r):
        self.id           = r['id']
        self.nom          = r['nom']
        self.prenom       = r['prenom']
        self.email        = r['email']
        self.role         = r['role']
        self.patient_code = r['patient_code']
    def get_id(self): return str(self.id)

@login_manager.user_loader
def load_user(uid):
    r = get_user_by_id(int(uid))
    return User(r) if r else None

# ─── EMAIL HELPER ────────────────────────────────
def send_email(to, subject, body):
    try:
        msg = MIMEMultipart()
        msg["Subject"] = subject
        msg["From"]    = GMAIL_FROM
        msg["To"]      = to
        msg.attach(MIMEText(body, "html", "utf-8"))
        with smtplib.SMTP_SSL("smtp.gmail.com", 465) as s:
            s.login(GMAIL_USER, GMAIL_PASS)
            s.sendmail(GMAIL_FROM, [to], msg.as_string())
        return True
    except Exception as e:
        log.error(f"Email: {e}")
        return False

# ─── MQTT ────────────────────────────────────────
MQTT_HOST = "localhost"
MQTT_PORT = 1883
MQTT_USER = "Issra"
MQTT_PASS = "Issra2026"
MQTT_OK   = False
patient_data = {}

def get_buf(code):
    if code not in patient_data:
        patient_data[code] = {
            'total': 0, 'signal_active': False, 'last_time': None
        }
    return patient_data[code]

def on_connect(c, u, f, rc):
    global MQTT_OK
    MQTT_OK = (rc == 0)
    if rc == 0:
        # ✅ ÉCOUTER TOUS LES TOPICS PATIENTS
        c.subscribe("ecg/data",         qos=0)
        c.subscribe("ecg/data/issra",   qos=0)
        c.subscribe("ecg/data/ridha",   qos=0)
        c.subscribe("ecg/alert",        qos=1)
        c.subscribe("ecg/alert/issra",  qos=1)
        c.subscribe("ecg/alert/ridha",  qos=1)
        log.info("✅ MQTT connecté — multi-patients")

def on_disconnect(c, u, rc):
    global MQTT_OK
def on_message(c, u, msg):
    """Recevoir les données ECG — support multi-patients"""
    try:
        d = json.loads(msg.payload)
        topic = msg.topic
        now = time.time()
        
        # Déterminer le patient selon le topic
        if "ridha" in topic:
            code = "RIDHA2026"
        elif "issra" in topic:
            code = "ISSRA2026"
        else:
            code = "ISSRA2026"
        
        if "data" in topic:  # Message ECG
            # Mettre à jour le timestamp et le statut
            if code not in patient_status:
                patient_status[code] = {"last_data": 0, "status": "En attente"}
            
            patient_status[code]["last_data"] = now
            patient_status[code]["status"] = "🟢 Signal actif"
            
            buf = get_buf(code)
            batch = d.get("b", [])
            
            if not buf['signal_active']:
                buf['signal_active'] = True
                buf['total'] = 0
                log.info(f"📡 Signal patient {code}")
            
            buf['last_time'] = now
            buf['total'] += len(batch)
            
            log.info(f"✉️ Envoi ECG {code}: {len(batch)} samples")
            
            # Envoyer les données au dashboard
            socketio.emit('ecg_batch', {
                'b': batch,
                'total': buf['total'],
                'code': code,
                'status': patient_status[code]["status"]
            })
            
        elif "alert" in topic:  # Message alerte
            if "ridha" in topic:
                code = "RIDHA2026"
            elif "issra" in topic:
                code = "ISSRA2026"
            else:
                code = "ISSRA2026"
            
            proba = d.get('proba', 0)
            alert = {
                'time': time.strftime("%H:%M:%S"),
                'date': time.strftime("%d/%m/%Y"),
                'proba': round(proba, 3),
                'patient': d.get('patient', ''),
                'code': code
            }
            
            save_alert(code, proba)
            socketio.emit('new_alert', alert)
            log.warning(f"🚨 ALERTE {code}")
            
    except Exception as e:
        log.error(f"❌ Erreur on_message: {e}")
def check_electrode_status():
    """Vérifier si l'électrode est branchée (données reçues dans les 10 dernières secondes)"""
    while True:
        time.sleep(10)  # Vérifier toutes les 10 secondes
        now = time.time()
        
        for patient_code in patient_status.keys():
            last_time = patient_status[patient_code]["last_data"]
            
            if last_time == 0:
                # Aucune donnée reçue
                patient_status[patient_code]["status"] = "⏳ En attente"
            elif now - last_time > 10:
                # Pas de données depuis 10 secondes
                patient_status[patient_code]["status"] = "❌ Électrode déconnectée"
            else:
                # Données reçues récemment
                patient_status[patient_code]["status"] = "🟢 Signal actif"

# Lancer le thread de vérification
import threading
electrode_thread = threading.Thread(target=check_electrode_status, daemon=True)
electrode_thread.start()
def mqtt_loop():
    """Boucle MQTT — multi-patients"""
    while True:
        try:
            c = mqtt.Client(client_id="cardioguard_main")
            c.username_pw_set(MQTT_USER, MQTT_PASS)
            c.on_disconnect = on_disconnect
            c.on_message = on_message
            c.on_connect = on_connect
            c.connect(MQTT_HOST, MQTT_PORT, keepalive=60)
            c.loop_forever()
        except Exception as e:
            log.error(f"MQTT: {e}")
            time.sleep(5)

def status_loop():
    """Afficher le statut toutes les secondes"""
    while True:
        for code, buf in patient_data.items():
            if buf['signal_active'] and buf['last_time']:
                if (time.time() - buf['last_time']) > 5:
                    buf['signal_active'] = False
                    buf['total'] = 0
                    socketio.emit('signal_lost', {'code': code})
        socketio.emit('status', {
            'mqtt_ok': MQTT_OK,
            'time':    time.strftime("%H:%M:%S"),
            'date':    time.strftime("%A %d %B %Y")
        })
        time.sleep(1)

threading.Thread(target=mqtt_loop,   daemon=True).start()
threading.Thread(target=status_loop, daemon=True).start()

