@app.route('/')
def index():
    if current_user.is_authenticated:
        return redirect(url_for('home'))
    return redirect(url_for('login'))

# ─── LOGIN ────────────────────────────────────────
@app.route('/login', methods=['GET', 'POST'])
def login():
    if current_user.is_authenticated:
        return redirect(url_for('home'))
    if request.method == 'POST':
        email    = request.form.get('email', '').strip()
        password = request.form.get('password', '')
        row      = get_user_by_email(email)
        if row and check_password(password, row['password_hash']):
            login_user(User(row))
            return redirect(url_for('home'))
        flash("Email ou mot de passe incorrect.", "error")
    return render_template('login.html')

# ─── REGISTER ─────────────────────────────────────
@app.route('/register', methods=['GET', 'POST'])
def register():
    if request.method == 'POST':
        nom          = request.form.get('nom', '').strip()
        prenom       = request.form.get('prenom', '').strip()
        email        = request.form.get('email', '').strip()
        password     = request.form.get('password', '')
        role         = request.form.get('role', '')
        patient_code = request.form.get('patient_code', '').strip().upper()

        if not all([nom, prenom, email, password, role]):
            flash("Tous les champs sont obligatoires.", "error")
            return render_template('register.html')

        if role in ['patient', 'famille']:
            if not patient_code:
                flash("Le code patient est obligatoire.", "error")
                return render_template('register.html')
            patient = get_patient_by_code(patient_code)
            if not patient:
                flash(f"Code patient '{patient_code}' introuvable. Contactez votre médecin.", "error")
                return render_template('register.html')

        ok, msg = create_user(nom, prenom, email, password, role, patient_code or None)
        if ok:
            flash("✅ Compte créé avec succès ! Vous pouvez vous connecter.", "success")
            return redirect(url_for('login'))
        flash(msg, "error")
    return render_template('register.html')

# ─── HOME → redirection selon rôle ───────────────
@app.route('/home')
@login_required
def home():
    if current_user.role == 'medecin':
        return redirect(url_for('medecin'))
    code = current_user.patient_code
    if not code:
        flash("Aucun patient associé. Contactez votre médecin.", "error")
        return redirect(url_for('login'))
    return redirect(url_for('dashboard', code=code))

# ─── MÉDECIN ─────────────────────────────────────
@app.route('/medecin')
@login_required
def medecin():
    if current_user.role != 'medecin':
        return redirect(url_for('home'))
    patients = get_all_patients(current_user.id)
    return render_template('medecin.html', user=current_user, patients=patients)

# ─── MÉDECIN — AJOUTER PATIENT ────────────────────
@app.route('/medecin/add-patient', methods=['GET', 'POST'])
@login_required
def add_patient():
    if current_user.role != 'medecin':
        return redirect(url_for('home'))
    if request.method == 'POST':
        nom    = request.form.get('nom', '').strip()
        prenom = request.form.get('prenom', '').strip()
        code   = request.form.get('code', '').strip().upper()
        if not all([nom, prenom, code]):
            flash("Tous les champs sont obligatoires.", "error")
            return render_template('add_patient.html', user=current_user)
        ok,  msg = create_patient(
             nom,
             prenom,
             code,
            current_user.id
         )
        if ok:
            flash(f"✅ Patient {prenom} {nom} ajouté. Code : {code}", "success")
            return redirect(url_for('medecin'))
        flash(msg, "error")
    return render_template('add_patient.html', user=current_user)

# ─── DASHBOARD ────────────────────────────────────
@app.route('/dashboard/<code>')
@login_required
def dashboard(code):
    patient = get_patient_by_code(code)
    if not patient:
        flash("Patient introuvable.", "error")
        return redirect(url_for('home'))
    if current_user.role != 'medecin' and current_user.patient_code != code:
        flash("Accès non autorisé.", "error")
        return redirect(url_for('home'))
    alerts = get_alerts(code, limit=20)
    return render_template('dashboard.html',
                           user=current_user,
                           patient=patient,
                           alerts=alerts)

# ─── MOT DE PASSE OUBLIÉ ─────────────────────────
@app.route('/forgot-password', methods=['GET', 'POST'])
def forgot_password():
    if request.method == 'POST':
        email = request.form.get('email', '').strip()
        row   = get_user_by_email(email)
        if row:
            # Générer token unique
            token = secrets.token_urlsafe(32)
            reset_tokens[token] = {'email': email, 'exp': time.time() + 3600}
            link  = f"{APP_URL}/reset-password/{token}"
            body  = f"""
            <div style="font-family:sans-serif;max-width:500px;margin:auto">
              <h2 style="color:#4f9cf9">CardioGuard — Réinitialisation</h2>
              <p>Bonjour <strong>{row['prenom']} {row['nom']}</strong>,</p>
              <p>Cliquez sur le lien ci-dessous pour réinitialiser votre mot de passe :</p>
              <a href="{link}" style="display:inline-block;padding:12px 24px;
                background:linear-gradient(135deg,#4f9cf9,#7c3aed);color:white;
                border-radius:8px;text-decoration:none;margin:16px 0">
                Réinitialiser mon mot de passe
              </a>
              <p style="color:#94a3b8;font-size:12px">Ce lien expire dans 1 heure.</p>
              <p style="color:#94a3b8;font-size:12px">Si vous n'avez pas demandé ceci, ignorez cet email.</p>
            </div>"""
            send_email(email, "CardioGuard — Réinitialisation de mot de passe", body)
        # Toujours afficher success (sécurité)
        flash("✅ Si cet email existe, un lien vous a été envoyé.", "success")
    return render_template('forgot_password.html')

# ─── RESET MOT DE PASSE ───────────────────────────
@app.route('/reset-password/<token>', methods=['GET', 'POST'])
def reset_password(token):
    data = reset_tokens.get(token)
    if not data or time.time() > data['exp']:
        flash("Lien expiré ou invalide.", "error")
        return redirect(url_for('forgot_password'))
    if request.method == 'POST':
        password = request.form.get('password', '')
        if len(password) < 6:
            flash("Le mot de passe doit faire au moins 6 caractères.", "error")
            return render_template('reset_password.html', token=token)
        update_password(data['email'], password)
        del reset_tokens[token]
        flash("✅ Mot de passe mis à jour ! Vous pouvez vous connecter.", "success")
        return redirect(url_for('login'))
    return render_template('reset_password.html', token=token)

# ─── CODE PATIENT OUBLIÉ ──────────────────────────
@app.route('/forgot-code', methods=['GET', 'POST'])
def forgot_code():
    if request.method == 'POST':
        email = request.form.get('email', '').strip()
        row   = get_user_by_email(email)
        if row and row['patient_code']:
            patient = get_patient_by_code(row['patient_code'])
            nom_patient = f"{patient['prenom']} {patient['nom']}" if patient else "votre patient"
            body = f"""
            <div style="font-family:sans-serif;max-width:500px;margin:auto">
              <h2 style="color:#4f9cf9">CardioGuard — Votre code patient</h2>
              <p>Bonjour <strong>{row['prenom']} {row['nom']}</strong>,</p>
              <p>Voici le code patient associé à votre compte :</p>
              <div style="background:#1e293b;border:2px solid #4f9cf9;border-radius:12px;
                padding:20px;text-align:center;margin:16px 0">
                <div style="font-size:28px;font-weight:700;color:#4f9cf9;
                  letter-spacing:4px">{row['patient_code']}</div>
                <div style="color:#94a3b8;font-size:13px;margin-top:6px">
                  Patient : {nom_patient}
                </div>
              </div>
              <a href="{APP_URL}/register" style="display:inline-block;padding:12px 24px;
                background:linear-gradient(135deg,#4f9cf9,#7c3aed);color:white;
                border-radius:8px;text-decoration:none">
                Aller à l'inscription
              </a>
            </div>"""
            send_email(email, "CardioGuard — Votre code patient", body)
        flash("✅ Si un code est associé à cet email, vous le recevrez.", "success")
    return render_template('forgot_code.html')

