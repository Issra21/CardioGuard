# ─── MODÈLE USER ────────────────────────────────
class User(UserMixin):
    def __init__(self, row):
        self.id           = row['id']
        self.nom          = row['nom']
        self.prenom       = row['prenom']
        self.email        = row['email']
        self.role         = row['role']
        self.patient_code = row['patient_code']
    def get_id(self): return str(self.id)

@login_manager.user_loader
def load_user(uid):
    row = get_user_by_id(int(uid))
    return User(row) if row else None

# ─── EMAIL HELPER ────────────────────────────────
def send_email(to, subject, body):
    try:
        msg = MIMEMultipart()
        msg["Subject"] = subject
        msg["From"]    = GMAIL_FROM
        msg["To"]      = to
        msg.attach(MIMEText(body, "html", "utf-8"))
        with smtplib.SMTP_SSL("smtp.gmail.com", 465) as s:
            s.login(GMAIL_FROM, GMAIL_PASS)
            s.sendmail(GMAIL_FROM, [to], msg.as_string())
        log.info(f"Email envoyé → {to}")
        return True
    except Exception as e:
        log.error(f"Email erreur: {e}")
        return False

# ─── MQTT ────────────────────────────────────────
MQTT_HOST = "localhost"; MQTT_PORT = 1883
MQTT_USER = "Issra";    MQTT_PASS = "Issra2026"
MQTT_OK   = False
patient_data = {}

def get_buf(code):
    if code not in patient_data:
        patient_data[code] = {
            'total': 0, 'signal_active': False, 'last_time': None
        }
    return patient_data[code]

def on_connect(c, u, f, rc):
    global MQTT_OK
    MQTT_OK = (rc == 0)
    if rc == 0:
        c.subscribe("ecg/data",  qos=0)
        c.subscribe("ecg/alert", qos=1)
        log.info("MQTT connecté")

def on_disconnect(c, u, rc):
    global MQTT_OK; MQTT_OK = False

def on_message(c, u, msg):
    try:
        d = json.loads(msg.payload)
        if msg.topic == "ecg/data":
            code  = "ISSRA2026"
            buf   = get_buf(code)
            batch = d.get("b", [])
            now   = time.time()
            if not buf['signal_active']:
                buf['signal_active'] = True
                buf['total'] = 0
            buf['last_time'] = now
            buf['total'] += len(batch)
            socketio.emit('ecg_batch', {'b': batch, 'total': buf['total'], 'code': code})
        elif msg.topic == "ecg/alert":
            code  = "ISSRA2026"
            proba = d.get('proba', 0)
            alert = {
                'time':    time.strftime("%H:%M:%S"),
                'date':    time.strftime("%d/%m/%Y"),
                'proba':   round(proba, 3),
                'patient': d.get('patient', 'Issra Saidi'),
                'code':    code
            }
            save_alert(code, proba)
            socketio.emit('new_alert', alert)
    except Exception as e:
        log.debug(f"MQTT msg err: {e}")

def mqtt_loop():
    while True:
        try:
            c = mqtt.Client(client_id="cardioguard_main")
            c.username_pw_set(MQTT_USER, MQTT_PASS)
            c.on_connect = on_connect
            c.on_disconnect = on_disconnect
            c.on_message = on_message
            c.connect(MQTT_HOST, MQTT_PORT, keepalive=60)
            c.loop_forever()
        except Exception as e:
            log.error(f"MQTT: {e}"); time.sleep(5)

def status_loop():
    while True:
        for code, buf in patient_data.items():
            if buf['signal_active'] and buf['last_time']:
                if (time.time() - buf['last_time']) > 5:
                    buf['signal_active'] = False
                    buf['total'] = 0
                    socketio.emit('signal_lost', {'code': code})
        socketio.emit('status', {
            'mqtt_ok': MQTT_OK,
            'time':    time.strftime("%H:%M:%S"),
            'date':    time.strftime("%A %d %B %Y")
        })
        time.sleep(1)

threading.Thread(target=mqtt_loop,   daemon=True).start()
threading.Thread(target=status_loop, daemon=True).start()

