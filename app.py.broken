@app.route('/forgot-password', methods=['GET','POST'])
def forgot_password():
    if request.method == 'POST':
        email = request.form.get('email','').strip()
        row   = get_user_by_email(email)
        if row:
            token = secrets.token_urlsafe(32)
            reset_tokens[token] = {'email':email,'exp':time.time()+3600}
            link  = f"{APP_URL}/reset-password/{token}"
            body  = f"""
            <div style="font-family:sans-serif;max-width:500px;margin:auto">
              <h2 style="color:#4f9cf9">💓 CardioGuard</h2>
              <p>Bonjour <strong>{row['prenom']} {row['nom']}</strong>,</p>
              <p>Cliquez ci-dessous pour réinitialiser votre mot de passe :</p>
              <a href="{link}" style="display:inline-block;padding:12px 24px;
                background:linear-gradient(135deg,#4f9cf9,#7c3aed);color:white;
                border-radius:8px;text-decoration:none;margin:16px 0">
                Réinitialiser mon mot de passe
              </a>
              <p style="color:#94a3b8;font-size:12px">Lien valable 1 heure.</p>
            </div>"""
            send_email(email, "CardioGuard — Réinitialisation mot de passe", body)
        flash("✅ Si cet email existe, un lien vous a été envoyé.", "success")
    return render_template('forgot_password.html')

@app.route('/reset-password/<token>', methods=['GET','POST'])
def reset_password(token):
    data = reset_tokens.get(token)
    if not data or time.time() > data['exp']:
        flash("Lien expiré ou invalide.", "error")
        return redirect(url_for('forgot_password'))
    if request.method == 'POST':
        password = request.form.get('password','')
        if len(password) < 6:
            flash("Minimum 6 caractères.", "error")
            return render_template('reset_password.html', token=token)
        update_password(data['email'], password)
        del reset_tokens[token]
        flash("✅ Mot de passe mis à jour !", "success")
        return redirect(url_for('login'))
    return render_template('reset_password.html', token=token)

@app.route('/forgot-code', methods=['GET','POST'])
def forgot_code():
    if request.method == 'POST':
        email = request.form.get('email','').strip()
        row   = get_user_by_email(email)
        if row and row['patient_code']:
            patient = get_patient_by_code(row['patient_code'])
            nom_p   = f"{patient['prenom']} {patient['nom']}" if patient else ""
            body = f"""
            <div style="font-family:sans-serif;max-width:500px;margin:auto">
              <h2 style="color:#4f9cf9">💓 CardioGuard — Votre code patient</h2>
              <p>Bonjour <strong>{row['prenom']} {row['nom']}</strong>,</p>
              <div style="background:#1e293b;border:2px solid #4f9cf9;
                border-radius:12px;padding:20px;text-align:center;margin:16px 0">
                <div style="font-size:28px;font-weight:700;color:#4f9cf9;
                  letter-spacing:4px">{row['patient_code']}</div>
                <div style="color:#94a3b8;font-size:13px;margin-top:6px">
                  Patient : {nom_p}</div>
              </div>
              <a href="{APP_URL}/register" style="display:inline-block;padding:12px 24px;
                background:linear-gradient(135deg,#4f9cf9,#7c3aed);color:white;
                border-radius:8px;text-decoration:none">
                Aller à l'inscription →
              </a>
            </div>"""
            send_email(email, "CardioGuard — Votre code patient", body)
        flash("✅ Si un code est associé à cet email, vous le recevrez.", "success")
    return render_template('forgot_code.html')

