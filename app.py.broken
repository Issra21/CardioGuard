@app.route('/')
def index():
    if current_user.is_authenticated:
        return redirect(url_for('home'))
    return redirect(url_for('login'))

@app.route('/login', methods=['GET', 'POST'])
@app.route('/login', methods=['GET', 'POST'])
@app.route('/login', methods=['GET', 'POST'])
def login():
    if request.method == 'POST':
        email = request.form.get('email')
        password = request.form.get('password')
        user = get_user_by_email(email)
        
        if user and check_password(password, user['password_hash']):
            # ✅ Vérifier que l'email est validé
            if user['verified'] == 0:
                flash("❌ Veuillez d'abord vérifier votre email", "error")
                return redirect(url_for('login'))
            
            # ✅ Email vérifié — créer la session
            session['user_id'] = user['id']
            session['user_email'] = user['email']
            session['user_role'] = user['role']
            session['user_nom'] = user['nom']
            session['user_prenom'] = user['prenom']
            
            # Créer l'objet User pour Flask-Login
            user_obj = User(user)
            login_user(user_obj)
            flash(f"✅ Bienvenue {user['prenom']} !", "success")
            log.info(f"🔓 Login : {email} ({user['role']})")
            
            # Rediriger selon le rôle
            if user['role'] == 'medecin':
                 return redirect(url_for('medecin'))
            else:
            # Patient et Famille vont au dashboard
                 return redirect(url_for('dashboard', code=user['patient_code']))
           
        else:
            flash("❌ Email ou mot de passe incorrect", "error")
            log.warning(f"⚠️  Tentative de login échouée : {email}")
    
    return render_template('login.html')
def send_verification_email(email, token):
    """Envoyer l'email de vérification"""
    try:
        verification_link = f"http://74.161.34.200/verify-email/{token}"
        
        msg = MIMEMultipart()
        msg['From'] = GMAIL_FROM
        msg['To'] = email
        msg['Subject'] = "Vérifiez votre email — CardioGuard"
        
        body = f"""
        <html>
            <body style="font-family: Arial; background: #f5f5f5; padding: 20px;">
                <div style="max-width: 600px; margin: 0 auto; background: white; padding: 30px; border-radius: 10px;">
                    <h2 style="color: #4f9cf9;">Bienvenue sur CardioGuard</h2>
                    <p>Cliquez sur le bouton ci-dessous pour vérifier votre email :</p>
                    <a href="{verification_link}" style="display: inline-block; padding: 12px 30px; background: #4f9cf9; color: white; text-decoration: none; border-radius: 6px; margin: 20px 0;">
                        Vérifier mon email
                    </a>
                    <p style="color: #999; font-size: 12px;">Ou copiez ce lien : {verification_link}</p>
                    <p style="color: #999; font-size: 12px;">Ce lien expire dans 24 heures.</p>
                </div>
            </body>
        </html>
        """
        
        msg.attach(MIMEText(body, 'html'))
        
        with smtplib.SMTP_SSL('smtp.gmail.com', 465) as server:
            server.login(GMAIL_USER, GMAIL_PASS)
            server.send_message(msg)
        
        log.info(f"✉️ Email envoyé à {email}")
        return True
    except Exception as e:
        log.error(f"❌ Erreur email: {e}")
        return False
@app.route('/register', methods=['GET', 'POST'])
def register():
    if request.method == 'POST':
        nom = request.form.get('nom', '').strip()
        prenom = request.form.get('prenom', '').strip()
        email = request.form.get('email', '').strip()
        password = request.form.get('password', '').strip()
        role = request.form.get('role', 'patient')
        patient_code = request.form.get('patient_code', '').strip() if role == 'patient' else None
        
        if not nom or not prenom or not email or not password:
            flash("❌ Tous les champs sont obligatoires", "error")
            return redirect(url_for('register'))
        
        if len(password) < 6:
            flash("❌ Le mot de passe doit faire au moins 6 caractères", "error")
            return redirect(url_for('register'))
        
        if role == 'patient' and not patient_code:
            flash("❌ Code patient obligatoire", "error")
            return redirect(url_for('register'))
        
        if get_user_by_email(email):
            flash("❌ Cet email existe déjà", "error")
            return redirect(url_for('register'))
        
        token = secrets.token_urlsafe(32)
        
        try:
            conn = get_conn()
            conn.execute('INSERT INTO users (nom, prenom, email, password_hash, role, patient_code, verified, verification_token) VALUES (?, ?, ?, ?, ?, ?, 0, ?)', (nom, prenom, email, hash_password(password), role, patient_code, token))
            conn.commit()
            conn.close()
        except Exception as e:
            flash(f"❌ Erreur : {e}", "error")
            return redirect(url_for('register'))
        
        send_verification_email(email, token)
        flash("✅ Inscription réussie ! Vérifiez votre email pour activer le compte.", "success")
        log.info(f"📝 Nouvelle inscription : {email} ({role})")
        return redirect(url_for('login'))
    
    return render_template('register.html')
@app.route('/verify-email/<token>')
def verify_email_route(token):
    """Vérifier l'email avec un token"""
    try:
        ok, msg = verify_email(token)
        if ok:
            flash("✅ Email vérifié ! Vous pouvez maintenant vous connecter.", "success")
        else:
            flash(f"❌ {msg}", "error")
    except:
        flash("❌ Lien invalide ou expiré", "error")
    
    return redirect(url_for('login'))            
